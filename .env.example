# Optional overrides only. Never commit .env or credentials.
EGON_VIDEO_STATE_DIR=/absolute/private/path/egon-creative
EGON_BLENDER=/Applications/Blender.app/Contents/MacOS/Blender
EGON_FFMPEG=ffmpeg
EGON_FFPROBE=ffprobe
EGON_TTS_VOICE=Damayanti
EGON_VIDEO_MAX_COST_IDR=25000
EGON_VIDEO_DEADLINE_SECONDS=3600
EGON_RENDER_ENGINE=EEVEE
# Explicit estimates, not a metered tariff/device reading:
EGON_POWER_WATTS_ESTIMATE=300
EGON_TARIFF_IDR_KWH_ESTIMATE=3000
# Gemini stays OFF unless all optional free-only checks are configured.
# EGON_GEMINI_ENABLED=free-only
# EGON_GEMINI_PROJECT=your-unbilled-project
# EGON_GEMINI_MODEL=currently-free-eligible-model
# EGON_GEMINI_MODEL_FREE_VERIFIED_ON=YYYY-MM-DD
# EGON_GOOGLE_OAUTH_TOKEN=never-put-a-real-token-in-this-example
